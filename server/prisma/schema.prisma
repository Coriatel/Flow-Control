// Flow Control - Blood Bank Inventory Management System
// Prisma Schema - PostgreSQL Version (Migrated)

generator client {
  provider        = "prisma-client-js"
  output          = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CORE ENTITIES
// ============================================================================

/// ספק - Supplier master data
model Supplier {
  id              String  @id @default(cuid())
  name            String  @unique
  shortCode       String?

  // פרטים
  address         String?
  phone           String?
  email           String?
  website         String?

  // תנאים
  defaultCurrency String  @default("ILS")
  paymentTerms    String?
  leadTimeDays    Int?

  // סטטוס
  isPreferred     Boolean @default(false)
  isActive        Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // קשרים
  reagents           Reagent[]
  contacts           SupplierContact[]
  orders             Order[]
  deliveries         Delivery[]
  withdrawalRequests WithdrawalRequest[]
  barcodeFormats     BarcodeFormat[]

  @@index([name])
  @@index([isActive])
}

/// איש קשר של ספק
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name       String
  role       String?
  phone      String?
  mobile     String?
  email      String?
  notes      String?

  isPrimary  Boolean  @default(false)
  isActive   Boolean  @default(true)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([supplierId])
}

/// ריאגנט - פריט קטלוגי עם מידע מצטבר
model Reagent {
  id                    String   @id @default(cuid())
  name                  String
  catalogNumber         String?
  category              String   @default("REAGENT") // REAGENT, CELLS, CONSUMABLE
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id])

  // מידע מלאי מצטבר (מתעדכן אוטומטית)
  totalQuantity         Float    @default(0)
  activeBatchesCount    Int      @default(0)
  nearestExpiryDate     DateTime?
  currentStockStatus    String   @default("NORMAL") // NORMAL, LOW, CRITICAL, OUT_OF_STOCK
  monthsOfStock         Float?

  // צריכה
  averageMonthlyUsage   Float?
  manualMonthlyUsage    Float?
  useManualUsage        Boolean  @default(false)

  // מטא
  isConsumable          Boolean  @default(false)
  requiresBatches       Boolean  @default(true)
  isDeleted             Boolean  @default(false)
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // קשרים
  batches               ReagentBatch[]
  transactions          InventoryTransaction[]
  orderItems            OrderItem[]
  withdrawalItems       WithdrawalItem[]
  deliveryItems         DeliveryItem[]
  shipmentItems         ShipmentItem[]
  frameworkOrderItems   FrameworkOrderItem[]
  dispenseEvents        DispenseEvent[]
  partialDisposals      PartialDisposal[]

  @@unique([name, supplierId])
  @@index([supplierId])
  @@index([category])
  @@index([currentStockStatus])
  @@index([nearestExpiryDate])
  @@index([isDeleted])
}

/// אצווה של ריאגנט
model ReagentBatch {
  id                String    @id @default(cuid())
  reagentId         String
  reagent           Reagent   @relation(fields: [reagentId], references: [id])

  batchNumber       String
  expiryDate        DateTime
  manufactureDate   DateTime?

  // כמויות
  initialQuantity   Float
  currentQuantity   Float
  reservedQuantity  Float     @default(0)

  // קבלה
  receivedDate      DateTime
  deliveryId        String?
  delivery          Delivery? @relation(fields: [deliveryId], references: [id])
  firstOpenedDate   DateTime?

  // אחסון
  storageLocation   String?
  storageConditions String?

  // סטטוס ואיכות
  status            String    @default("ACTIVE") // INCOMING, ACTIVE, EXPIRED, CONSUMED, ON_HOLD, DESTROYED
  qcStatus          String    @default("PENDING") // PENDING, APPROVED, REJECTED, REQUIRES_REVIEW
  coaDocumentUrl    String?
  qcNotes           String?
  generalNotes      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // קשרים
  transactions      InventoryTransaction[]
  expiredProductLogs ExpiredProductLog[]
  dispenseEvents    DispenseEvent[]
  partialDisposals  PartialDisposal[]

  @@unique([reagentId, batchNumber])
  @@index([reagentId])
  @@index([expiryDate])
  @@index([status])
  @@index([deliveryId])
}

// ============================================================================
// ORDERS & PROCUREMENT
// ============================================================================

/// הזמנה
model Order {
  id                    String   @id @default(cuid())

  // מספרים
  tempNumber            String   @unique
  permanentNumber       String?
  sapPurchaseOrder      String?

  // ספק
  supplierId            String
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  supplierSnapshot      String   // שם ספק בעת ההזמנה

  // סוג וסטטוס
  orderType             String   @default("IMMEDIATE") // IMMEDIATE, FRAMEWORK
  status                String   @default("DRAFT") // DRAFT, PENDING_SAP, APPROVED, PARTIALLY_RECEIVED, FULLY_RECEIVED, CLOSED, CANCELLED

  // תאריכים
  orderDate             DateTime @default(now())
  expectedDeliveryStart DateTime?
  expectedDeliveryEnd   DateTime?
  closedDate            DateTime?

  // כספים
  totalValue            Float?
  currency              String   @default("ILS")

  // הערות
  internalNotes         String?
  supplierNotes         String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // קשרים
  items                 OrderItem[]
  deliveries            Delivery[]
  frameworkOrder        FrameworkOrder?

  @@index([supplierId])
  @@index([status])
  @@index([orderType])
  @@index([orderDate])
}

/// פריט בהזמנה
model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reagentId         String
  reagent           Reagent  @relation(fields: [reagentId], references: [id])

  requestedQuantity Float
  approvedQuantity  Float?
  receivedQuantity  Float    @default(0)
  remainingQuantity Float?

  unitPrice         Float?
  currency          String   @default("ILS")

  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([orderId])
  @@index([reagentId])
}

/// הזמנת מסגרת - הרחבה להזמנה רגילה
model FrameworkOrder {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  validFrom         DateTime
  validTo           DateTime
  maxTotalQuantity  Float?
  availableQuantity Float?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // קשרים
  items              FrameworkOrderItem[]
  withdrawalRequests WithdrawalRequest[]

  @@index([validFrom, validTo])
}

/// פריט בהזמנת מסגרת
model FrameworkOrderItem {
  id                String         @id @default(cuid())
  frameworkOrderId  String
  frameworkOrder    FrameworkOrder @relation(fields: [frameworkOrderId], references: [id], onDelete: Cascade)
  reagentId         String
  reagent           Reagent        @relation(fields: [reagentId], references: [id])

  allocatedQuantity Float
  consumedQuantity  Float          @default(0)
  availableQuantity Float

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([frameworkOrderId])
  @@index([reagentId])
}

// ============================================================================
// WITHDRAWALS
// ============================================================================

/// בקשת משיכה
model WithdrawalRequest {
  id                  String          @id @default(cuid())
  withdrawalNumber    String          @unique

  // ספק ומסגרת
  supplierId          String
  supplier            Supplier        @relation(fields: [supplierId], references: [id])
  supplierSnapshot    String
  frameworkOrderId    String?
  frameworkOrder      FrameworkOrder? @relation(fields: [frameworkOrderId], references: [id])

  // סטטוס
  status              String          @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, SHIPPING, CLOSED, CANCELLED

  // תאריכים
  requestDate         DateTime        @default(now())
  approvalDate        DateTime?
  completionDate      DateTime?

  // כספים
  totalValueRequested Float?
  totalValueApproved  Float?

  // הערות
  requesterNotes      String?
  approverNotes       String?

  // שדות נוספים
  urgencyLevel          String?       // routine, urgent, emergency
  requestedDeliveryDate DateTime?
  specialInstructions   String?

  // משתמשים
  requestedById       String?
  approvedById        String?

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // קשרים
  items               WithdrawalItem[]
  deliveries          Delivery[]

  @@index([supplierId])
  @@index([status])
  @@index([frameworkOrderId])
  @@index([requestDate])
}

/// פריט בבקשת משיכה
model WithdrawalItem {
  id                  String            @id @default(cuid())
  withdrawalRequestId String
  withdrawalRequest   WithdrawalRequest @relation(fields: [withdrawalRequestId], references: [id], onDelete: Cascade)
  reagentId           String
  reagent             Reagent           @relation(fields: [reagentId], references: [id])

  requestedQuantity   Float
  approvedQuantity    Float?
  fulfilledQuantity   Float             @default(0)

  unitPrice           Float?

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([withdrawalRequestId])
  @@index([reagentId])
}

// ============================================================================
// DELIVERIES & SHIPMENTS
// ============================================================================

/// משלוח נכנס
model Delivery {
  id                  String             @id @default(cuid())
  deliveryNumber      String             @unique

  // ספק
  supplierId          String
  supplier            Supplier           @relation(fields: [supplierId], references: [id])
  supplierSnapshot    String

  // קישורים
  orderId             String?
  order               Order?             @relation(fields: [orderId], references: [id])
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id])

  // תאריכים וסטטוס
  deliveryDate        DateTime
  status              String             @default("NEW") // NEW, PROCESSING, COMPLETED, CANCELLED

  // תיעוד
  documentUrl         String?
  isRecurringSupply   Boolean            @default(false)
  notes               String?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // קשרים
  items               DeliveryItem[]
  batches             ReagentBatch[]

  @@index([supplierId])
  @@index([status])
  @@index([deliveryDate])
  @@index([orderId])
}

/// פריט במשלוח נכנס
model DeliveryItem {
  id              String   @id @default(cuid())
  deliveryId      String
  delivery        Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  reagentId       String
  reagent         Reagent  @relation(fields: [reagentId], references: [id])

  batchNumber     String
  quantity        Float
  expiryDate      DateTime

  acceptedQuantity  Float?
  rejectedQuantity  Float?
  rejectionReason   String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deliveryId])
  @@index([reagentId])
}

/// משלוח יוצא
model Shipment {
  id                    String   @id @default(cuid())
  shipmentNumber        String   @unique

  destinationHospital   String
  destinationDepartment String?

  shipmentDate          DateTime
  status                String   @default("DRAFT") // DRAFT, SENT, RECEIVED, CANCELLED

  documentUrl           String?
  notes                 String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // קשרים
  items                 ShipmentItem[]

  @@index([status])
  @@index([shipmentDate])
}

/// פריט במשלוח יוצא
model ShipmentItem {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  reagentId  String
  reagent    Reagent  @relation(fields: [reagentId], references: [id])
  batchId    String?

  quantity   Float

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([shipmentId])
  @@index([reagentId])
}

// ============================================================================
// INVENTORY MANAGEMENT
// ============================================================================

/// טיוטת ספירת מלאי
model InventoryCountDraft {
  id          String   @id @default(cuid())

  startedAt   DateTime @default(now())
  lastSavedAt DateTime @updatedAt
  status      String   @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED

  startedById String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // קשרים
  entries     InventoryCountEntry[]

  @@index([status])
}

/// שורת ספירה
model InventoryCountEntry {
  id            String              @id @default(cuid())
  countDraftId  String
  countDraft    InventoryCountDraft @relation(fields: [countDraftId], references: [id], onDelete: Cascade)

  reagentId     String
  batchNumber   String?

  countedQuantity Float
  expiryDate      DateTime?

  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([countDraftId])
  @@index([reagentId])
}

/// ספירת מלאי מושלמת
model CompletedInventoryCount {
  id                   String   @id @default(cuid())

  countDate            DateTime
  completedAt          DateTime @default(now())

  totalReagentsCounted Int
  totalBatchesCounted  Int
  varianceSummary      String?  // JSON string

  csvExportUrl         String?
  pdfReportUrl         String?

  completedById        String?

  createdAt            DateTime @default(now())

  @@index([countDate])
}

/// תנועת מלאי
model InventoryTransaction {
  id              String        @id @default(cuid())

  reagentId       String
  reagent         Reagent       @relation(fields: [reagentId], references: [id])
  batchId         String?
  batch           ReagentBatch? @relation(fields: [batchId], references: [id])

  transactionType String        // RECEIPT, CONSUMPTION, WITHDRAWAL, ADJUSTMENT, DESTRUCTION, TRANSFER_IN, TRANSFER_OUT
  quantityDelta   Float         // חיובי להוספה, שלילי להפחתה

  // מקור
  sourceType      String?       // delivery, withdrawal, count, destruction
  sourceId        String?

  performedById   String?
  notes           String?

  createdAt       DateTime      @default(now())

  @@index([reagentId])
  @@index([batchId])
  @@index([transactionType])
  @@index([createdAt])
}

/// רישום מוצר פג תוקף
model ExpiredProductLog {
  id          String       @id @default(cuid())

  reagentId   String
  batchId     String
  batch       ReagentBatch @relation(fields: [batchId], references: [id])

  quantity    Float
  actionTaken String       // DESTROYED, CONSUMED, NOT_IN_STOCK, OTHER

  handledById String?
  handledAt   DateTime     @default(now())
  reason      String?
  notes       String?

  createdAt   DateTime     @default(now())

  @@index([batchId])
  @@index([handledAt])
}

// ============================================================================
// ALERTS & NOTIFICATIONS
// ============================================================================

/// כלל התראה
model AlertRule {
  id                  String   @id @default(cuid())

  ruleType            String   // EXPIRY_WARNING, LOW_STOCK, PENDING_SUPPLY, COUNT_REQUIRED, COA_MISSING, CUSTOM
  name                String
  description         String?

  // פרמטרים
  thresholdDays       Int?
  thresholdQuantity   Float?
  thresholdMonths     Float?

  // קטגוריות - stored as comma-separated string
  appliesToCategories String   @default("")

  isActive            Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  // קשרים
  alerts              ActiveAlert[]

  @@index([ruleType])
  @@index([isActive])
}

/// התראה פעילה
model ActiveAlert {
  id              String    @id @default(cuid())

  alertRuleId     String
  alertRule       AlertRule @relation(fields: [alertRuleId], references: [id])

  // מה מתריע
  entityType      String    // reagent, batch, order, etc.
  entityId        String

  severity        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status          String    @default("NEW") // NEW, IN_PROGRESS, RESOLVED, DISMISSED

  message         String
  details         String?   // JSON string

  // טיפול
  resolvedById    String?
  resolvedAt      DateTime?
  resolutionNotes String?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([alertRuleId])
  @@index([entityType, entityId])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

/// הערת דשבורד / משימה
model DashboardNote {
  id          String    @id @default(cuid())

  title       String?
  content     String
  noteType    String    @default("GENERAL") // GENERAL, TASK, REMINDER, ALERT, INFO

  priority    Int       @default(0)
  isPinned    Boolean   @default(false)

  ctaRoute    String?   // קישור לדף

  createdById String?
  dismissedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([noteType])
  @@index([isPinned])
  @@index([dismissedAt])
}

/// תזכורת מתוזמנת
model ScheduledReminder {
  id           String    @id @default(cuid())

  reminderType String
  targetDate   DateTime
  assignedTo   String?

  title        String
  message      String?

  isCompleted  Boolean   @default(false)
  completedAt  DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([targetDate])
  @@index([isCompleted])
}

// ============================================================================
// SYSTEM & CONFIGURATION
// ============================================================================

/// הגדרות מערכת
model SystemSettings {
  id                String   @id @default(cuid())
  key               String   @unique
  value             String   // JSON string
  description       String?
  
  // Display settings fields
  mainHeaderName    String?
  sidebarHeaderName String?
  logoUrl           String?

  updatedAt         DateTime @updatedAt
}

/// נתונים בארכיון
model ArchivedData {
  id           String    @id @default(cuid())

  entityType   String
  entityId     String
  payload      String    // JSON string

  archivedAt   DateTime  @default(now())
  archivedById String?

  restoredAt   DateTime?
  restoredById String?

  @@index([entityType])
  @@index([archivedAt])
}

// ============================================================================
// MESSAGING SYSTEM
// ============================================================================

/// הודעות בין משתמשים
model Message {
  id              String    @id @default(cuid())
  senderId        String
  senderName      String
  recipientType   String    @default("ALL")      // ALL, SELECTED, SINGLE
  recipientIds    String    @default("[]")        // JSON array
  title           String
  content         String
  messageType     String    @default("MESSAGE")   // MESSAGE, ALERT, NOTIFICATION
  priority        String    @default("NORMAL")    // LOW, NORMAL, HIGH, URGENT
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  recipients      MessageRecipient[]

  @@index([senderId])
  @@index([createdAt])
  @@map("messages")
}

/// נמענים של הודעה
model MessageRecipient {
  id          String    @id @default(cuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  isDismissed Boolean   @default(false)
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([messageId, userId])
  @@index([userId])
  @@index([isRead])
  @@map("message_recipients")
}

/// דוח בארכיון
model ArchivedReport {
  id          String   @id @default(cuid())

  reportType  String
  reportDate  DateTime
  title       String

  fileUrl     String?
  metadata    String?  // JSON string

  createdAt   DateTime @default(now())

  @@index([reportType])
  @@index([reportDate])
}

/// תיעוד פיצ'ר / ידע
model DocumentationNote {
  id              String   @id @default(cuid())

  pageId          String?
  title           String
  content         String
  category        String?

  relatedEntities String   @default("") // Comma-separated

  lastEditorId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([pageId])
  @@index([category])
}

/// משתמש
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  password          String    // Hashed password using bcrypt
  role              String    @default("USER") // ADMIN, MANAGER, USER, READONLY
  deviceFingerprint String?

  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("app_users")
  @@index([email])
  @@index([role])
  @@index([isActive])
}

/// יומן פעילות
model ActivityLog {
  id          String   @id @default(cuid())

  userId      String?
  action      String
  entityType  String?
  entityId    String?

  details     String?  // JSON string
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// BARCODE & DISPENSING (v2)
// ============================================================================

/// פורמט ברקוד - הגדרות פיענוח לפי ספק/מוצר
model BarcodeFormat {
  id              String    @id @default(cuid())
  name            String
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])

  barcodeType     String    @default("CODE128") // CODE128, QR, DATAMATRIX, EAN13, GS1_128
  parsePattern    String                         // Regex or GS1 AI pattern
  fieldMapping    String                         // JSON: {lotNumber, expiryDate, catalogNumber, quantity}
  dateFormat      String    @default("YYMMDD")
  sampleData      String?
  notes           String?

  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([supplierId])
  @@index([barcodeType])
}

/// אירוע הוצאה - רישום הוצאת פריט מהמלאי לשימוש
model DispenseEvent {
  id              String       @id @default(cuid())
  reagentId       String
  reagent         Reagent      @relation(fields: [reagentId], references: [id])
  batchId         String
  batch           ReagentBatch @relation(fields: [batchId], references: [id])

  quantity        Float
  dispensedById   String?
  dispensedAt     DateTime     @default(now())

  scanMethod      String       @default("BARCODE") // BARCODE, QR, MANUAL, SEARCH
  rawScanData     String?
  purpose         String?
  notes           String?

  createdAt       DateTime     @default(now())

  @@index([reagentId])
  @@index([batchId])
  @@index([dispensedAt])
  @@index([dispensedById])
}

/// השלכה חלקית - רישום השלכת חלק מפריט בשימוש (ברבעים)
model PartialDisposal {
  id               String       @id @default(cuid())
  reagentId        String
  reagent          Reagent      @relation(fields: [reagentId], references: [id])
  batchId          String
  batch            ReagentBatch @relation(fields: [batchId], references: [id])

  portionDisposed  Float                          // 0.25 (רבע), 0.50 (חצי), 0.75 (שלושה רבעים), 1.00 (מלא)
  originalQuantity Float                          // הכמות המקורית מה-DispenseEvent, לחישוב בזבוז
  reason           String                         // EXPIRED_IN_USE, CONTAMINATED, DAMAGED, OTHER
  notes            String?

  disposedById     String?
  disposedAt       DateTime     @default(now())

  createdAt        DateTime     @default(now())

  @@index([batchId])
  @@index([disposedAt])
}
