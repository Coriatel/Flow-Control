# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database
# Connection pool settings are included in the URL query params:
# - connection_limit: Maximum number of connections in the pool (default: 10)
# - pool_timeout: How long to wait for a connection (seconds, default: 10)
# - connect_timeout: How long to wait when connecting (seconds, default: 5)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flow_control?connection_limit=10&pool_timeout=30"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File Upload
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
# Options: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=debug

# Optional: Email (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password

# Production Configuration Example:
# DATABASE_URL="postgresql://user:password@host:5432/database?connection_limit=20&pool_timeout=30&sslmode=require"
# JWT_SECRET=very-long-random-string-at-least-32-characters
# CORS_ORIGIN=https://your-domain.com
# LOG_LEVEL=info
